    "@mui/material": ">=5 <6",
    "react": ">=18 <19",
    "react-dom": ">=18 <19"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^5.8.3",
    "@storybook/react-vite": "^10.5.5",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^10.5.5",
    "typescript": "~5.4.3"
  },
  "packageManager": "pnpm@10.32.1"
