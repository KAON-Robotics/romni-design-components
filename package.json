{
  "name": "@kaon-robotics/design-components",
  "version": "0.1.10",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "node --test test/*.test.mjs",
    "test:storybook": "vitest --project=storybook --run",
    "test:storybook:coverage": "vitest --project=storybook --run --coverage",
    "check": "pnpm run build && pnpm run test"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "peerDependencies": {
    "@emotion/react": ">=11 <12",
    "@emotion/styled": ">=11 <12",
    "@mui/material": ">=5 <6",
    "react": ">=18 <19",
    "react-dom": ">=18 <19"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^5.8.3",
    "@storybook/addon-a11y": "^10.5.6",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/addon-vitest": "^10.5.6",
    "@storybook/react-vite": "^10.5.6",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "playwright": "^1.62.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^10.5.6",
    "typescript": "~5.4.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.32.1"
}
